// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Song {
  id         Int     @id @default(autoincrement())
  legacyId   Int? @unique
  title      String
  slug       String @unique
  lyrics     String
  artist     String?
  isDeleted  Boolean @default(false)
  holyricsId String?

  arrangements SongArrangement[]
  tags         Tag[]
}

model HolyricsConfig {
  id    Int    @id @default(1)
  token String @default("")
  host  String @default("localhost:8091")
}

// Como um grupo de tags se apresenta na tela de Músicas (ver docs/SPEC_CATEGORIZACAO_VISAO.md).
enum TagGroupPresentation {
  FEATURED // cards em destaque na home (grade, sem rolagem lateral)
  SHELF    // prateleira de cards com rolagem lateral
  FILTER   // nunca na home, só como filtro dentro da lista
}

// Cardinalidade do grupo: quantos valores uma mesma música pode ter.
enum TagGroupSelection {
  SINGLE
  MULTI
}

model TagGroup {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  color        String               @default("#6b7280")
  order        Int                  @default(0)
  // A pergunta que o grupo responde, em linguagem do dia a dia (ex.: "Para qual data ou ritual a música serve?").
  description  String?
  presentation TagGroupPresentation @default(FILTER)
  selection    TagGroupSelection    @default(MULTI)
  // Grupo ainda em validação com o ministério: a tela mostra o selo "em construção".
  isProposed   Boolean              @default(false)
  tags         Tag[]
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  tagGroupId  Int
  group       TagGroup @relation(fields: [tagGroupId], references: [id])
  songs       Song[]
  // Identidade visual opcional da página da tag; sem valores, vale a cor do grupo.
  description String?
  color       String?
  pattern     String?
  imageUrl    String?

  @@unique([name, tagGroupId])
}

model SongArrangement {
  id        Int     @id @default(autoincrement())
  songId    Int
  originalArrangementId Int?
  key       String
  name      String?
  isDefault Boolean @default(false)
  isDeleted Boolean @default(false)
  isServiceArrangement Boolean @default(false)

  youtubeUrl   String?

  song      Song @relation(fields: [songId], references: [id])
  originalArrangement SongArrangement? @relation("OriginalArrangement", fields: [originalArrangementId], references: [id])
  childrenArrangements SongArrangement[] @relation("OriginalArrangement")
  serviceUnit ServiceUnit?
  units SongUnit[]
  audios ArrangementAudio[]
}

model ArrangementAudio {
  id            Int             @id @default(autoincrement())
  arrangementId Int
  arrangement   SongArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  url           String
  label         String
  order         Int             @default(0)
}

model SongUnit {
  id        Int     @id @default(autoincrement())
  arrangementId Int
  content   String
  type      SongUnitType
  order     Int
  notes       String?
  repeatCount Int     @default(1)

  arrangement SongArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
}

enum SongUnitType {
  BLOCK
  INTRO
  VERSE
  PRECHORUS
  CHORUS
  BRIDGE
  INTERLUDE
  SOLO
  ENDING
  TEXT
}

model Service {
  id              Int      @id @default(autoincrement())
  legacyId        Int?     @unique
  title           String?
  slug            String   @unique
  worshipLeader   String?
  date            DateTime
  isDeleted       Boolean  @default(false)
  preacher        String?
  sermonTheme     String?
  sermonReference String?
  plan            Json?
  updatedAt       DateTime @default(now()) @updatedAt

  units ServiceUnit[]
}

model ServiceTemplate {
  id    Int    @id @default(autoincrement())
  name  String
  items Json
}

model ServiceUnit {
  id                Int             @id @default(autoincrement())
  serviceId         Int
  type              ServiceUnitType
  arrangementId     Int?            @unique
  semitoneTranspose Int?            @default(0)
  order             Int

  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arrangement SongArrangement? @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
}

enum ServiceUnitType {
  SONG
  FALA
  LEITURA
  ORACAO
  AVISOS
  SERMAO
  ENCERRAMENTO
}

