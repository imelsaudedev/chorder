// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Song {
  id         Int     @id @default(autoincrement())
  legacyId   Int? @unique
  title      String
  slug       String @unique
  lyrics     String
  artist     String?
  isDeleted  Boolean @default(false)
  holyricsId String?

  arrangements SongArrangement[]
  tags         Tag[]
}

model HolyricsConfig {
  id    Int    @id @default(1)
  token String @default("")
  host  String @default("localhost:8091")
}

// Como um grupo de tags se apresenta na tela de Músicas (ver docs/SPEC_CATEGORIZACAO_VISAO.md).
enum TagGroupPresentation {
  FEATURED // cards em destaque na home (grade, sem rolagem lateral)
  SHELF    // prateleira de cards com rolagem lateral
  FILTER   // nunca na home, só como filtro dentro da lista
}

// Cardinalidade do grupo: quantos valores uma mesma música pode ter.
enum TagGroupSelection {
  SINGLE
  MULTI
}

model TagGroup {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  color        String               @default("#6b7280")
  order        Int                  @default(0)
  // A pergunta que o grupo responde, em linguagem do dia a dia (ex.: "Para qual data ou ritual a música serve?").
  description  String?
  presentation TagGroupPresentation @default(FILTER)
  selection    TagGroupSelection    @default(MULTI)
  // Grupo ainda em validação com o ministério: a tela mostra o selo "em construção".
  isProposed   Boolean              @default(false)
  tags         Tag[]
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  tagGroupId  Int
  group       TagGroup @relation(fields: [tagGroupId], references: [id])
  songs       Song[]
  // Identidade visual opcional da página da tag; sem valores, vale a cor do grupo.
  description String?
  color       String?
  pattern     String?
  imageUrl    String?
  // Posição da tag dentro do grupo (escolhida na administração); empate cai para o nome.
  order       Int      @default(0)

  @@unique([name, tagGroupId])
}

model SongArrangement {
  id        Int     @id @default(autoincrement())
  songId    Int
  originalArrangementId Int?
  key       String
  name      String?
  isDefault Boolean @default(false)
  isDeleted Boolean @default(false)
  isServiceArrangement Boolean @default(false)

  youtubeUrl   String?

  song      Song @relation(fields: [songId], references: [id])
  originalArrangement SongArrangement? @relation("OriginalArrangement", fields: [originalArrangementId], references: [id])
  childrenArrangements SongArrangement[] @relation("OriginalArrangement")
  serviceUnit ServiceUnit?
  units SongUnit[]
  audios ArrangementAudio[]
}

model ArrangementAudio {
  id            Int             @id @default(autoincrement())
  arrangementId Int
  arrangement   SongArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  url           String
  label         String
  order         Int             @default(0)
}

model SongUnit {
  id        Int     @id @default(autoincrement())
  arrangementId Int
  content   String
  type      SongUnitType
  order     Int
  notes       String?
  repeatCount Int     @default(1)

  arrangement SongArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
}

enum SongUnitType {
  BLOCK
  INTRO
  VERSE
  PRECHORUS
  CHORUS
  BRIDGE
  INTERLUDE
  SOLO
  ENDING
  TEXT
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
}

enum ServiceScope {
  CHURCH
  PERSONAL
}

enum ServiceSharePermission {
  VIEW
  EDIT
}

model Service {
  id              Int           @id @default(autoincrement())
  legacyId        Int?          @unique
  title           String?
  slug            String        @unique
  worshipLeader   String?
  date            DateTime
  isDeleted       Boolean       @default(false)
  status          ServiceStatus @default(PUBLISHED)
  scope           ServiceScope  @default(CHURCH)
  createdById     String?
  shareToken      String?       @unique
  preacher        String?
  preacherId      String?
  sermonTheme     String?
  sermonReference String?
  plan            Json?
  updatedAt       DateTime      @default(now()) @updatedAt

  createdBy    User?          @relation("CreatedServices", fields: [createdById], references: [id], onDelete: SetNull)
  preacherUser User?          @relation("ServicePreacher", fields: [preacherId], references: [id], onDelete: SetNull)
  leaders      ServiceLeader[]
  shares       ServiceShare[]
  units     ServiceUnit[]

  @@index([createdById])
  @@index([preacherId])
  @@index([scope])
}

/// Quem conduz a liturgia. Pode haver mais de uma pessoa, com ou sem conta (userId nulo = nome digitado).
/// `Service.worshipLeader` guarda o texto derivado ("Hugo, Ana e Caio") para listas e estatísticas.
model ServiceLeader {
  id        Int     @id @default(autoincrement())
  serviceId Int
  userId    String?
  name      String
  order     Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User?   @relation("ServiceLeaderUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([userId])
}

model ServiceShare {
  id         Int                    @id @default(autoincrement())
  serviceId  Int
  userId     String
  permission ServiceSharePermission @default(VIEW)
  createdAt  DateTime               @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([userId])
}

model ServiceTemplate {
  id    Int    @id @default(autoincrement())
  name  String
  items Json
}

model ServiceUnit {
  id                Int             @id @default(autoincrement())
  serviceId         Int
  type              ServiceUnitType
  arrangementId     Int?            @unique
  semitoneTranspose Int?            @default(0)
  order             Int

  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arrangement SongArrangement? @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
}

enum ServiceUnitType {
  SONG
  FALA
  LEITURA
  ORACAO
  AVISOS
  SERMAO
  ENCERRAMENTO
}

enum UserRole {
  ADMIN
  WORSHIP
  MEDIA
  USER
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  roles           UserRole[]     @default([])
  accounts        Account[]
  sessions        Session[]
  createdServices Service[]      @relation("CreatedServices")
  preachedServices Service[]     @relation("ServicePreacher")
  ledServices     ServiceLeader[] @relation("ServiceLeaderUser")
  sharedServices  ServiceShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
